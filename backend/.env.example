# MedPin backend configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# ── Server ────────────────────────────────────────────────
# development or test for local runs; anything else (or empty) = production.
# Production requires real secrets and never returns sign-in codes.
NODE_ENV=
PORT=
# Public base URL of this API (used in signed file links), e.g. https://api.medpin.in
PUBLIC_URL=
# Comma-separated origins allowed to call the API (Flutter web, admin tools)
CORS_ORIGINS=

# ── MongoDB ───────────────────────────────────────────────
# Local (MongoDB Compass): mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=

# ── Auth (JWT) ────────────────────────────────────────────
# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# e.g. 15m and 30d
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
# Secret mixed into stored OTP / consent-code hashes
OTP_HASH_SECRET=

# ── Sign-in codes ─────────────────────────────────────────
# dev (local testing: no SMS, code shown in the app), msg91 (this server sends
# the SMS) or firebase (Firebase Phone Auth in the app)
SMS_PROVIDER=
# Firebase project id (google-services.json → project_info.project_id)
FIREBASE_PROJECT_ID=

# ── SMS OTP (MSG91) ───────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Template for sign-in codes, and for verifying a new patient's / team member's phone
MSG91_TEMPLATE_LOGIN=
MSG91_TEMPLATE_REGISTER=
# Test numbers (ignored in production): code is returned by the API, no SMS sent.
# Default: the demo front desk and patient, 9749681391,9230592842
DEV_OTP_PHONES=

# ── WhatsApp reminders (Meta WhatsApp Cloud API) ──────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Push notifications (Firebase Cloud Messaging) ─────────
# Either the path (from this folder) of the service-account JSON from Firebase
# (Project settings → Service accounts → Generate new private key; keep it out of git) …
FCM_SERVICE_ACCOUNT_FILE=
# … or its three values. The key goes on ONE line in double quotes, with \n
# for the line breaks: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Check with: npm run check:push   (the startup log also says "[push] FCM on" or what's missing)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Email (report / invoice copies) ───────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── File storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ──
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local folder for files when S3 is not set (default ./uploads)
UPLOADS_DIR=

# ── AI assistant ──────────────────────────────────────────
# Which AI answers: gemini or anthropic (default: whichever key is set)
AI_PROVIDER=
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# e.g. gemini-3.8-flash / gemini-3.8-flash / gemini-embedding-2
GEMINI_CHAT_MODEL=
GEMINI_VISION_MODEL=
GEMINI_EMBED_MODEL=
# Claude (optional alternative)
ANTHROPIC_API_KEY=
AI_MODEL=

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Maps (clinic pins, distance to doctor) ────────────────
GOOGLE_MAPS_API_KEY=

# ── ABDM (HPR / HFR / ABHA linking) ───────────────────────
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=

# ── Help and support (shown in the app; requests are emailed here) ──
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Medicine ordering from a partner pharmacy (cart, delivery / pickup) in the patient app.
# off until there is a pharmacy partner; on to turn it on.
PHARMACY_ORDERING=off
